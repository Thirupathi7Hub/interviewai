PORT=5001
NODE_ENV=development

# ── Database (Supabase) ───────────────────────────────────────────────────────
# Get these from: https://supabase.com → Project → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this
SESSION_SECRET=your_session_secret_change_this

# ── Google OAuth 2.0 ──────────────────────────────────────────────────────────
# Setup at: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5001/auth/google/callback

# ── Frontend URL (for CORS & OAuth redirects) ────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── AI Providers (Automatic Cascade: 1.NVIDIA → 2.Groq → 3.Gemini → 4.Mock) ─
# Configure one, two, or all three. The system automatically switches to the
# next provider if the primary one fails or runs out of credits.

# Priority 1: NVIDIA NIM (meta/llama-3.2-11b-vision-instruct)
# Get key at: https://build.nvidia.com
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxx
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_MODEL_EVAL=meta/llama-3.2-11b-vision-instruct
NVIDIA_NEMOTRON_KEY=nvapi-xxxxxxxxxxxxxxxxxxxx

# Priority 2: Groq Cloud (Ultra-fast Meta Llama)
# Get free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.1-8b-instant

# Priority 3: Google Gemini (Free & generous limits)
# Get key at: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-1.5-flash

# Priority 4: Mock AI (Automatic fallback when all providers fail, or when true)
USE_MOCK_AI=false

# Optional Backup: OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
