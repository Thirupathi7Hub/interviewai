PORT=5001
JWT_SECRET=your_super_secret_jwt_key_change_this
SESSION_SECRET=your_session_secret_change_this

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5001/auth/google/callback

# Frontend URL (for redirects)
CLIENT_URL=http://localhost:5173

# ── AI Provider — Choose ONE (leave others blank) ─────────────────────────────

# Option 1: NVIDIA NIM Cloud API (recommended — fast, free tier available)
# Get key at: https://build.nvidia.com → "Get API Key"
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxx       # Text model (questions + evaluation)
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_NEMOTRON_KEY=nvapi-xxxxxxxxxxxxxxxxxxxx  # Vision model (face confidence) — can be same key

# Option 2: OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# Option 3: Google Gemini
GEMINI_API_KEY=your_gemini_api_key

# Option 4: Mock Mode (no API key needed — uses built-in responses)
USE_MOCK_AI=false
